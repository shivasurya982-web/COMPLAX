# ==============================================================================
# COMPLAX - Multi-Organization Complaint Management System Environment Variables
# ==============================================================================

# Backend Port (default: 5000)
PORT=5000
HOST=0.0.0.0

# Flask debug mode (0 for production/standard local run, 1 for development)
FLASK_DEBUG=0

# Secret key for security and session handling
SECRET_KEY=complax-secure-secret-key-change-in-production

# MongoDB Atlas Connection URI
# Leave unset or empty to use high-speed local persistent JSON database in backend/data/
# Or provide your MongoDB connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/complax_db?retryWrites=true&w=majority

# Frontend API Base URL
VITE_API_URL=http://localhost:5000/api
